---
import { href } from '../data/site';
import media from '../data/media.json';
import Photo from './Photo.astro';
import Icon from './Icon.astro';
interface Props { id: string; title: string; poster: string; heading?: string; buttonLabel?: string; posterAlt?: string }
const { id, title, poster, heading = 'See the prototype in action.', buttonLabel = 'Play the release video', posterAlt = 'RI3D team with the prototype robot; play the release video.' } = Astro.props;
---
<section class="video-section" aria-label={title}>
  <div class="section-heading"><h2>{heading}</h2><a class="text-link" href={`https://www.youtube.com/watch?v=${id}`} target="_blank" rel="noopener noreferrer">Watch on YouTube<Icon name="external" size={16} /></a></div>
  <div class="video-frame" data-video={id} data-video-title={title}>
    <Photo image={poster} alt={posterAlt} />
    <button class="video-launch" aria-label={`Play ${title}`} data-video-launch><span><Icon name="play" size={28}/></span><strong>{buttonLabel}</strong><small>Loads a YouTube video when selected</small></button>
  </div>
</section>
